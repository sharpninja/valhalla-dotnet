  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpNinja.Valhalla\SharpNinja.Valhalla.csproj" />
  </ItemGroup>
</Project>