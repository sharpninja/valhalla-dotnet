<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>valhalla-dotnet</ToolCommandName>
    <PackageId>SharpNinja.Valhalla.Generation.Tool</PackageId>
    <Version>2.0.0</Version>
    <Authors>SharpNinja</Authors>
    <Description>Command-line and container entry point for deterministic managed Valhalla generation.</Description>
    <PackageTags>valhalla;osm;routing;generation;mjolnir;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyName>valhalla-dotnet</AssemblyName>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    <ValhallaUpstreamVersion>3.8.3</ValhallaUpstreamVersion>
    <ValhallaUpstreamCommit>a60c7cbfc83e073f50887cd27e0109d02e6b64e5</ValhallaUpstreamCommit>
    <RepositoryUrl>https://github.com/sharpninja/valhalla-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" />
    <AssemblyMetadata Include="ValhallaUpstreamVersion" Value="$(ValhallaUpstreamVersion)" />
    <AssemblyMetadata Include="ValhallaUpstreamCommit" Value="$(ValhallaUpstreamCommit)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpNinja.Valhalla.Generation\SharpNinja.Valhalla.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
