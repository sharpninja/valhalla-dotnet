<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pure managed engine (no platform APIs); net10.0 is consumed unchanged by net10.0-android /
         net10.0-ios / desktop projects via TFM fallback, so no platform TFMs or workloads needed. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>SharpNinja.Valhalla</PackageId>
    <Version>1.4.0</Version>
    <Authors>SharpNinja</Authors>
    <Description>Embedded, in-process C# port of the Valhalla OSM routing engine with provider-neutral routing, traffic and closure feed normalization, route-modifier analysis, and Valhalla traffic edge/tile integration.</Description>
    <PackageTags>valhalla;osm;routing;navigation;maps;offline</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/sharpninja/valhalla-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sharpninja/valhalla-dotnet</PackageProjectUrl>
  </PropertyGroup>

  <!-- Package the repo README for the nuget.org listing. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Odin narrative locale dictionaries (verbatim copies of upstream valhalla locales/*.json),
       embedded so NarrativeDictionaryLoader can load them by BCP-47 tag at runtime. LogicalName is
       deterministic: SharpNinja.Valhalla.Odin.Locales.<tag>.json -->
  <ItemGroup>
    <EmbeddedResource Include="Odin\Locales\*.json">
      <LogicalName>SharpNinja.Valhalla.Odin.Locales.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The ported engine's internal test helpers/constants are exercised by the engine's own test
       suite in this repo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SharpNinja.Valhalla.Tests" />
  </ItemGroup>
</Project>
