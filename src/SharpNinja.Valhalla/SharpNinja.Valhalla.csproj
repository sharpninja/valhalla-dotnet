<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pure managed engine (no platform APIs); net10.0 is consumed unchanged by net10.0-android /
         net10.0-ios / desktop projects via TFM fallback, so no platform TFMs or workloads needed. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>SharpNinja.Valhalla</PackageId>
    <Version>1.0.0</Version>
    <Authors>SharpNinja</Authors>
    <Description>Embedded, in-process C# port of the Valhalla OSM routing engine (Baldr graph reader, Sif costing, Thor route engine, Odin directions, Mjolnir tile builder) with a provider-neutral routing client. Consumes local Valhalla tiles; no external routing server.</Description>
    <PackageTags>valhalla;osm;routing;navigation;maps;offline</PackageTags>
    <RepositoryUrl>https://github.com/sharpninja/valhalla-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sharpninja/valhalla-dotnet</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The ported engine's internal test helpers/constants are exercised by the engine's own test
       suite in this repo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SharpNinja.Valhalla.Tests" />
  </ItemGroup>
</Project>
